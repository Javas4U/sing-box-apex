# ====================================
# 生产级 sing-box Docker 镜像
# ====================================

# 构建阶段
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS builder

LABEL maintainer="your-email@example.com"
LABEL description="Production-ready sing-box proxy server"

# 设置工作目录
WORKDIR /build

# 安装构建依赖
RUN apk add --no-cache \
    git \
    build-base \
    tzdata

# 复制源代码
COPY . .

# 设置构建参数
ARG TARGETOS
ARG TARGETARCH
ARG GOPROXY=""
ARG VERSION

ENV GOPROXY=${GOPROXY}
ENV CGO_ENABLED=0
ENV GOOS=${TARGETOS}
ENV GOARCH=${TARGETARCH}

# 编译
RUN set -ex && \
    export COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown") && \
    export VERSION=${VERSION:-$(go run ./cmd/internal/read_tag 2>/dev/null || echo "dev")} && \
    go build -v -trimpath \
        -tags "with_gvisor,with_quic,with_dhcp,with_wireguard,with_utls,with_acme,with_clash_api,with_tailscale" \
        -ldflags "-X 'github.com/sagernet/sing-box/constant.Version=${VERSION}' -s -w -buildid=" \
        -o /build/sing-box \
        ./cmd/sing-box

# 运行阶段
FROM alpine:latest

LABEL maintainer="your-email@example.com"
LABEL description="Production-ready sing-box proxy server"

# 安装运行时依赖
RUN apk add --no-cache \
    bash \
    tzdata \
    ca-certificates \
    nftables \
    iptables \
    iproute2 \
    curl \
    && rm -rf /var/cache/apk/*

# 创建必要的目录
RUN mkdir -p \
    /etc/sing-box \
    /var/log/sing-box \
    /var/lib/sing-box \
    && chmod 755 /etc/sing-box /var/log/sing-box /var/lib/sing-box

# 从构建阶段复制二进制文件
COPY --from=builder /build/sing-box /usr/local/bin/sing-box
RUN chmod +x /usr/local/bin/sing-box

# 创建非特权用户(可选,根据需要启用)
# RUN addgroup -g 1000 sing-box && \
#     adduser -D -u 1000 -G sing-box sing-box && \
#     chown -R sing-box:sing-box /etc/sing-box /var/log/sing-box /var/lib/sing-box

# 设置工作目录
WORKDIR /etc/sing-box

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:9090/health || exit 1

# 暴露常用端口
EXPOSE 1080/tcp 1080/udp  # SOCKS/HTTP
EXPOSE 8388/tcp 8388/udp  # VMess
EXPOSE 443/tcp 443/udp    # Trojan/HTTPS
EXPOSE 9090/tcp           # API/Web UI

# 定义卷
VOLUME ["/etc/sing-box", "/var/log/sing-box", "/var/lib/sing-box"]

# 设置环境变量
ENV TZ=Asia/Shanghai \
    SING_BOX_CONFIG=/etc/sing-box/config.json

# 启动命令
ENTRYPOINT ["/usr/local/bin/sing-box"]
CMD ["run", "-c", "/etc/sing-box/config.json"]
